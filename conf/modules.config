/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: ARRIBA_ARRIBA {
        ext.prefix =  { "${meta.id}.arriba" }

        publishDir = [
            [
                path: "${params.outdir}/fusions/arriba/",
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: FASTQC {
        cpus   = { 2 }
        memory = { 5.GB * task.attempt }
        time   = { 10.m + (1.ms * reads.sum { it.size() } / reads.count { it } / 1000) * task.attempt }

        ext.args       = '--quiet'
        publishDir     = [
            [
                path: "${params.outdir}/QC/fastqc",
                mode: params.publish_dir_mode,
            ]
        ]
    }

    withName: FUSIONINSPECTOR {
        cpus   = { 12 }
        memory = { 40.GB * task.attempt }
        time   = { 4.h * task.attempt }

        ext.args = { params.fusioninspector_limitSjdbInsertNsj != 1000000 ? "--STAR_xtra_params \"--limitSjdbInsertNsj ${params.fusioninspector_limitSjdbInsertNsj}\"" : '' }
        ext.args2 = '--annotate --examine_coding_effect'
        publishDir = [
            path: { "${params.outdir}/fusioninspector/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: FUSIONREPORT_DETECT {
        ext.args = {'--no-cosmic'}

        publishDir = [
            path: { "${params.outdir}/fusions/fusion_report/${meta.id}/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: FUSIONREPORT_DOWNLOAD {
        cpus     = 1
        memory   = {2.GB}
        time     = {10.m}

        ext.args = {'--no-cosmic'}
        scratch = true
    }

    withName: GATK4_BEDTOINTERVALLIST {
        ext.args = '--DROP_MISSING_CONTIGS TRUE'
        storeDir = params.cache_dir ? "${params.cache_dir}/gatk4/bedtointervallist" : null
    }

    withName: GATK4_CREATESEQUENCEDICTIONARY {
        storeDir = params.cache_dir ? "${params.cache_dir}/gatk4/createsequencedictionary" : null
    }

    withName: GATK4_INTERVALLISTTOOLS {
        ext.args    = { [
            "--SUBDIVISION_MODE BALANCING_WITHOUT_INTERVAL_SUBDIVISION_WITH_OVERFLOW",
            "--UNIQUE true",
            "--SORT true",
            "--SCATTER_COUNT ${params.scatter_size}"
        ].join(' ').trim() }
        storeDir = params.cache_dir ? "${params.cache_dir}/gatk4/intervallisttools" : null
    }

    withName: GATK4_HAPLOTYPECALLER {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
        array  = params.scatter_size

        ext.args = { [
            "--dont-use-soft-clipped-bases",
            "--standard-min-confidence-threshold-for-calling ${params.min_confidence_threshold}",
            "--emit-ref-confidence GVCF"
        ].join(' ').trim() }
    }

    withName: GATK4_SPLITNCIGARREADS {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h   * task.attempt }
        array  = params.scatter_size

        ext.args    =  '--create-output-bam-index false'
        ext.prefix  = { "${meta.id}.splitncigarreads" }
    }

    withName: GATK4_VARIANTFILTRATION {
        cpus   = 1
        memory = { 6.GB * task.attempt }
        time   = { 2.h  * task.attempt }

        ext.prefix  = { "${meta.id}.hc.filtered" }
        ext.args    = { [
            params.gatk_vf_window_size ? "--cluster-window-size ${params.gatk_vf_window_size}" : '',
            params.gatk_vf_cluster_size ? "--cluster-size ${params.gatk_vf_cluster_size}" : '',
            params.gatk_vf_fs_filter ? "--filter-name \"FS\" --filter-expression \"FS > ${params.gatk_vf_fs_filter}\" " : '',
            params.gatk_vf_qd_filter ? "--filter-name \"QD\" --filter-expression \"QD < ${params.gatk_vf_qd_filter}\" " : '',
        ].join(' ').trim() }
        publishDir  = [
            path: { "${params.outdir}/variant_calling/" },
            mode: params.publish_dir_mode
        ]
    }

    withName: BEDOPS_GTF2BED {
        storeDir = params.cache_dir ? "${params.cache_dir}/gtf2bed" : null
    }

    withName: HGNC_DOWNLOAD {
        cpus = 1
        memory = { 1.GB }
        time = { 5.m * task.attempt }
    }

    withName: MULTIQC {
        cpus           = { 2 }
        memory         = { 2.GB * task.attempt }
        time           = { 15.m * task.attempt }

        ext.args       = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : "--title \"${params.analysis_id}\"" }
        ext.prefix     = { params.analysis_id }
        publishDir     = [
            [
                path: { "${params.outdir}/QC" },
                mode: params.publish_dir_mode,
            ]
        ]
    }

    withName: OUTRIDER {
        cpus   = 10
        memory = { 40.GB * task.attempt }
        time   = { 60.m * task.attempt }

        ext.mode   = { meta.level }
        ext.args   = { "--mode ${meta.level}" }
        ext.prefix = { "${meta.id}_${meta.level}_${meta.panel}" }

        publishDir =  [
                   [path: "${params.outdir}/outrider/", mode: params.publish_dir_mode]
        ]
    }

    withName: PICARD_COLLECTRNASEQMETRICS {
        cpus           = { 2 }
        memory         = { 5.GB * task.attempt }
        time           = { 2.h * task.attempt }

        clusterOptions = "${params.cluster_options} --gres=tmpspace:10G"
        ext.args       = '--STRAND_SPECIFICITY NONE'
        publishDir     = [
            [
                path: "${params.outdir}/QC/Picard",
                mode: params.publish_dir_mode,
            ]
        ]

    }

    withName: PRESEQ_LCEXTRAP {
        cpus           = { 2 * task.attempt }
        memory         = { 5.GB * task.attempt }
        time           = {
            def t = (1.ms * bam.size() / 1600)
            (t < 10.m ? 10.m: t)  * task.attempt
        }

        ext.args = {
            [
                '-verbose',
                '-bam',
                '-defects',
                '-seed 1',
                '-seg_len 10000000',
            ].join(' ').trim()
        }
        publishDir = [
            [
                path: "${params.outdir}/QC/lcextrap",
                mode: params.publish_dir_mode,
            ]
        ]

    }

    withName: 'RSEQC_(BAMSTAT|INNERDISTANCE|INFEREXPERIMENT|JUNCTIONANNOTATION|JUNCTIONSATURATION|READDISTRIBUTION|READDUPLICATION)' {
        cpus   = { 2 * task.attempt }
        memory = {
            def mem = (8.B * bam.size())
            (mem < 5.GB ? 5.GB : mem) * task.attempt
        }
        time = {
            def t = (1.ms * bam.size() / 1600)
            (t < 10.m ? 10.m: t)  * task.attempt
        }

        publishDir = [
            [
                path: "${params.outdir}/QC/rseqc",
                mode: params.publish_dir_mode,
            ]
        ]

    }

    withName: SAMTOOLS_CONVERT {
        cpus           = { 2 }
        memory         = { 16.GB * task.attempt }
        time           = { 4.h * task.attempt }

        publishDir     = [
            [
                path: "${params.outdir}/cram_files/",
                mode: params.publish_dir_mode,
                pattern: '*.cra?',
            ]
        ]

    }

    withName: SAMTOOLS_FLAGSTAT {
        cpus           = { 2 }
        memory         = { 5.GB * task.attempt }
        time           = { 1.h * task.attempt }

        publishDir     = [
            [
                path: "${params.outdir}/QC/samtools",
                mode: params.publish_dir_mode,
            ]
        ]
    }

    withName: SAMTOOLS_IDXSTATS {
        cpus           = { 2 }
        memory         = { 5.GB * task.attempt }
        time           = { 1.h * task.attempt }

        publishDir     = [
            [
                path: "${params.outdir}/QC/samtools",
                mode: params.publish_dir_mode,
            ]
        ]

    }

    withName: SAMTOOLS_INDEX {
        cpus           = { 2 }
        memory         = { 5.GB * task.attempt }
        time           = { 15.m * task.attempt }
    }

    withName: SAMTOOLS_MERGE {
        cpus           = { 2 }
        memory         = { 5.GB * task.attempt }
        time           = { (1.ms * bam.size() / 8000) * task.attempt }

        ext.args       = '--write-index'
    }

    withName: SAMTOOLS_STATS {
        publishDir = [
            [
                path: "${params.outdir}/QC/samtools",
                mode: params.publish_dir_mode,
            ]
        ]
    }

    withName: SORTMERNA_INDEX {
        cpus           = { 2 * task.attempt }
        memory         = { 64.GB * task.attempt }
        time           = { 4.h * task.attempt }

        clusterOptions = "${params.cluster_options} --constraint=avx512"
        container      = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/15/15b50826336c394eab2bf6d731f00729921598ffc6463278da6316e768b16b8b/data'
        ext.args       = '--index 1'
        publishDir     = [
            path: "${params.outdir}/genome/sortmerna",
            mode: params.publish_dir_mode,
        ]

    }

    withName: SORTMERNA_READS {
        cpus           = { 12 * task.attempt }
        memory         = { 64.GB * task.attempt }
        time           = { 16.h * task.attempt }

        clusterOptions = "${params.cluster_options} --constraint=avx512"
        container      = 'https://community-cr-prod.seqera.io/docker/registry/v2/blobs/sha256/15/15b50826336c394eab2bf6d731f00729921598ffc6463278da6316e768b16b8b/data'
        ext.args       = '--num_alignments 1 -v --index 0'
        publishDir     = [
            [
                path: { "${params.outdir}/sortmerna" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
            ],
            [
                path: { params.save_non_ribo_reads ? "${params.outdir}/sortmerna" : params.outdir },
                mode: params.publish_dir_mode,
                pattern: "*.fastq.gz",
                saveAs: { params.save_non_ribo_reads ? it : null },
            ]
        ]

    }

    withName: STAR_ALIGN {
        cpus           = { 12 * task.attempt }
        memory         = { 40.GB * task.attempt }
        time           = {
            def t = (1.ms * reads.sum { it.size() } / reads.count { it } / 300)
            (t < 30.m ? 30.m : t) * task.attempt
        }

        ext.args       = {
            [
                '--readFilesCommand zcat',
                '--outSAMtype BAM SortedByCoordinate',
                '--outSAMunmapped Within',
                '--outReadsUnmapped None',
                '--outSAMstrandField intronMotif',
                '--twopassMode None',
                // Multimapper tuning
                '--outFilterMultimapNmax 50',
                '--chimMultimapNmax 50',
                // Chimeric detection tuning
                '--chimOutJunctionFormat 1',  //essential for starfusion includes required metadata in Chimeric.junction.out file.
                '--chimOutType Junctions WithinBAM', // Junctions essential for starfusion and WithinBam for arriba
                '--chimSegmentMin 10',
                '--chimJunctionOverhangMin 10',
                '--chimScoreJunctionNonGTAG 0',
                '--chimScoreDropMax 30',
                '--chimScoreSeparation 1',
                '--chimSegmentReadGapMax 3',
                // Shared splice stitch setting
                '--alignSJstitchMismatchNmax 5 -1 5 5', // settings improved certain chimera detections
                // Extra output for visualisation
                '--outWigStrand Unstranded',
                '--outWigType bedGraph',
            ].join(' ').trim()
        }
        publishDir     = [
            [
                path: "${params.outdir}/QC/star_align",
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                        filename.endsWith('.bam') || filename.endsWith(".fastq.gz") ? null : filename
                }
            ]
        ]
    }

    withName: STARFUSION_DETECT {
        cpus   = { 12 * task.attempt }
        memory = { 40.GB * task.attempt }
        time   = { 2.h * task.attempt }

        publishDir = [
            [
                path: "${params.outdir}/fusions/starfusion/",
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        ]
    }

    withName: SUBREAD_FEATURECOUNTS_GENE {
        cpus       = { 2 * task.attempt }
        memory     = { 36.GB * task.attempt }
        time       = { 8.h * task.attempt }

        ext.prefix = { "${meta.id}.gene" }
        ext.args   = {
            [
                "-g gene_id",
                "-J", // Count the number of reads supporting each exon-exon junction
                "-M", // count multi mapping reads
                "--extraAttributes gene_type,gene_name",
                "--largestOverlap",
                "--verbose",
            ].join(' ').trim()
        }

        publishDir = [
            [
                path: "${params.outdir}/feature_counts/",
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    filename.replace(".featureCounts", "").replaceAll(/(?i)(cntrl|control|ctrl)/, "cntrl.cntrl").replace("plusCHX", "plusCHX.chx")
                }
            ]
        ]
    }

    withName: SUBREAD_FEATURECOUNTS_EXON {
        cpus       = { 2 * task.attempt }
        memory     = { 36.GB * task.attempt }
        time       = { 15.m * task.attempt }
        ext.prefix = { "${meta.id}.exon" }

        ext.args   = {
            [
                "-g exon_id",
                "-J", // Count the number of reads supporting each exon-exon junction
                "-M", // Count multi-mapping reads
                "--extraAttributes gene_type,gene_name",
                "--largestOverlap",
                "--verbose",

            ].join(' ').trim()
        }
        publishDir = [
            [
                path: "${params.outdir}/feature_counts/",
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                    filename.replace(".featureCounts", "").replaceAll(/(?i)(cntrl|control|ctrl)/, "cntrl.cntrl").replace("plusCHX", "plusCHX.chx")
                }
            ]
        ]

    }

    withName: TRIMGALORE {
        cpus           = { 12 * task.attempt }
        memory         = { 5.GB * task.attempt }
        time           = { (1.ms * reads.sum { it.size() } / reads.count { it } / 170) * task.attempt }

        publishDir     = [
            [
                path: "${params.outdir}/QC/trimgalore",
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                        filename.endsWith('.fq.gz') ? null : filename
                }
            ]
        ]

    }

    withName: UMITOOLS_DEDUP {
        cache          = false // Never resume this process to avoid downstream errors
        clusterOptions = "${params.cluster_options} --gres=tmpspace:200G"
        ext.args       = {
            [
                "--umi-separator=:",
                "--temp-dir \${TMPDIR}",
            ].join(' ').trim()
        }
        ext.prefix     = { "${meta.id}.dedup" }
        publishDir     = [
            [
                path: "${params.outdir}/QC/umitools_dedup",
                mode: params.publish_dir_mode,
                saveAs: { filename ->
                        filename.endsWith('.bam') || filename.endsWith('.bai') ? null: filename
                }
            ]
        ]
        cpus           = { 6 * task.attempt }
        memory         = { 32.GB * task.attempt }
        time           = { 8.h * task.attempt }
    }

}
